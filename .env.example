# =============================================================================
# Verified Company Profile System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# All values below are safe placeholders. No real credentials are included.
# See docs/project/07_DEVELOPMENT_AND_TESTING.md §3 for full documentation.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
APP_NAME=Verified Company Profile
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
LOG_LEVEL=INFO
DEFAULT_LOCALE=vi
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# PostgreSQL is reachable from the host at localhost:5433 by default.
# The API and worker use the internal Compose address postgres:5432.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://vcps:vcps_dev@postgres:5432/vcps
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Authentication ---
AUTH_MODE=mock
AUTH_PROJECT_ID=your-project-id
AUTH_AUDIENCE=your-audience

# --- AI Provider ---
# AI is optional; disabled still runs official-website fetch and deterministic extraction.
AI_PROVIDER=disabled
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT=60
AI_MAX_RETRIES=3

# --- Search Provider ---
# Set google only with both credentials below. fixture is test-only.
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=your-search-api-key-placeholder
SEARCH_ENGINE_ID=your-search-engine-id-placeholder

# --- Fetch ---
FETCH_USER_AGENT=VCPS-Bot/0.1 (+https://example.com/bot)
FETCH_TIMEOUT=30
FETCH_MAX_RESPONSE_BYTES=10000000
FETCH_MAX_DECOMPRESSED_BYTES=10000000
FETCH_MAX_REDIRECTS=5
FETCH_MAX_RETRIES=2
FETCH_RATE_LIMIT_SECONDS=0.25
FETCH_MAX_CONCURRENCY_PER_DOMAIN=2
FETCH_BROWSER_FALLBACK_MAX_PAGES=2
FETCH_BROWSER_FALLBACK_ENABLED=false
CRAWL_MAX_DEPTH=1
CRAWL_MAX_PAGES_PER_DOMAIN=25
CRAWL_MAX_PAGES_PER_JOB=50
CRAWL_MAX_SITEMAPS=3
CRAWL_MAX_SITEMAP_URLS=100

# --- Object Storage ---
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./data/storage
GCS_BUCKET=your-gcs-bucket-placeholder
SIGNED_URL_EXPIRY_SECONDS=300

# --- Malware Scanner ---
MALWARE_SCANNER_MODE=mock

# --- Worker ---
TASK_DISPATCHER=postgres
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL=5
WORKER_CLAIM_LEASE_SECONDS=300
WORKER_BATCH_SIZE=5
WORKER_RETRY_BASE_DELAY=10
WORKER_RETRY_MAX_DELAY=600

# --- Frontend (browser-safe only) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Verified Company Profile
# Local mock token only; use mock-token-admin for workspace administration screens.
# Rebuild the web image after changing this value because NEXT_PUBLIC_* is bundled at build time.
NEXT_PUBLIC_MOCK_AUTH_TOKEN=mock-token-researcher
